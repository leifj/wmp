[
  {
    "id": "message-deliver-plaintext",
    "description": "Deliver a plaintext JSON message in a TLS session.",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "method": "wmp.message.deliver",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4",
          "sender": "x509:san:dns:alice.example.com",
          "timestamp": "2026-04-29T10:15:30Z"
        },
        "to": ["x509:san:dns:bob.example.com"],
        "content_type": "application/json",
        "body": {
          "text": "Hello, Bob!"
        }
      }
    },
    "notes": "Notification — no response expected. Recipient validates session_id and sender membership."
  },
  {
    "id": "message-deliver-encrypted",
    "description": "Deliver an MLS-encrypted message.",
    "conformance_level": "secure",
    "input": {
      "jsonrpc": "2.0",
      "method": "wmp.message.deliver",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4",
          "sender": "x509:san:dns:alice.example.com",
          "encrypted": true,
          "epoch": 3
        },
        "ciphertext": "dGVzdC1jaXBoZXJ0ZXh0LWV4YW1wbGU"
      }
    },
    "notes": "ciphertext is base64url-encoded MLS MLSMessage. Recipient decrypts using epoch 3 keys."
  },
  {
    "id": "message-deliver-encrypted-plaintext-hash",
    "description": "Deliver an MLS-encrypted message with a salted plaintext commitment (wmp-core §5.2.1).",
    "conformance_level": "secure",
    "input": {
      "jsonrpc": "2.0",
      "method": "wmp.message.deliver",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4",
          "sender": "x509:san:dns:alice.example.com",
          "encrypted": true,
          "epoch": 3
        },
        "ciphertext": "dGVzdC1jaXBoZXJ0ZXh0LWV4YW1wbGU",
        "plaintext_hash": {
          "algorithm": "sha-256",
          "value": "jT3sLEbm6jtEXJoRUHMf1knqSz0673mVbQZH8I6oB7w"
        }
      }
    },
    "notes": "The plaintext content object (inside the ciphertext, after decryption) is {\"to\":[\"x509:san:dns:bob.example.com\"],\"content_type\":\"text/plain\",\"body\":\"hello\",\"salt\":\"q83vEjRWeJq83vEjRWeJqw\"}. Its JCS form is {\"body\":\"hello\",\"content_type\":\"text/plain\",\"salt\":\"q83vEjRWeJq83vEjRWeJqw\",\"to\":[\"x509:san:dns:bob.example.com\"]}; SHA-256 of those UTF-8 bytes, base64url without padding, is plaintext_hash.value above. The §5.4 content object for signing is {\"ciphertext\":...,\"plaintext_hash\":{...}}. A recipient whose decrypted plaintext hashes to anything else rejects with -31019 and does not ack. The ciphertext here is a placeholder, not a real MLSMessage."
  },
  {
    "id": "message-ack-received",
    "description": "Acknowledge receipt of a message.",
    "conformance_level": "basic",
    "input": {
      "jsonrpc": "2.0",
      "method": "wmp.message.ack",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4",
          "sender": "x509:san:dns:bob.example.com"
        },
        "message_ids": ["msg-001"],
        "status": "received"
      }
    },
    "notes": "Notification — no response expected."
  },
  {
    "id": "message-deliver-with-signature",
    "description": "Deliver a message with a non-repudiation signature.",
    "conformance_level": "registered",
    "input": {
      "jsonrpc": "2.0",
      "method": "wmp.message.deliver",
      "params": {
        "wmp": {
          "version": "0.1",
          "session_id": "ses-a1b2c3d4",
          "sender": "x509:san:dns:alice.example.com",
          "timestamp": "2026-04-29T10:15:30Z",
          "signature": {
            "alg": "ES256",
            "kid": "x509:san:dns:alice.example.com#key-1",
            "value": "MEUCIQC7k..."
          }
        },
        "to": ["x509:san:dns:bob.example.com"],
        "content_type": "application/json",
        "body": { "text": "Signed message" }
      }
    },
    "notes": "Signature computed over JCS-canonicalized params (excluding wmp metadata). Verifiable by third parties."
  }
]
